# ─────────────────────────────────────────────────────────────
# MiMundoTrenzas — Variables de Entorno (Plantilla)
# Copia este archivo como .env y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# ── Aplicación ──────────────────────────────────────────────
APP_NAME=MiMundoTrenzas
APP_ENV=development
BASE_URL=/HomeWorks/Design_Project

# ── Base de Datos ────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=auth_system_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Moneda Base ──────────────────────────────────────────────
BASE_CURRENCY=USD

# ── Pasarela de Pagos (Stripe) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── API de Tipo de Cambio (ExchangeRate-API) ────────────────
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
