RewriteEngine On

# Base del proyecto (ajustar si cambia la ruta del proyecto)
RewriteBase /HomeWorks/Design_Project/

# Bloquear acceso directo a archivos dentro de App/
RewriteRule ^App/ - [F,L]

# Bloquear acceso directo a archivos .env
RewriteRule ^\.env$ - [F,L]

# No reescribir si el archivo o directorio existe físicamente
# (CSS, JS, imágenes, fuentes, etc. se sirven directamente)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirigir TODAS las peticiones restantes al Front Controller
# La URI original se pasa como parámetro 'url'
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
